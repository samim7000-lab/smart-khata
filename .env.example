# Supabase Configuration
# Copy this file to .env and fill in your project values from the Supabase Dashboard:
# Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Authentication Mode: 'development' (login without SMS OTP) or 'production' (real SMS OTP)
VITE_AUTH_MODE=development
